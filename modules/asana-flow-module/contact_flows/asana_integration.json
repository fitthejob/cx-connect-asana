        },
        "isFriendlyName": true
      },
      "ReturnCaseNumber": {
        "position": {
          "x": 2360,
          "y": 20
        },
        "isFriendlyName": true
      }
    }
  },
  "Actions": [
    {
      "Identifier": "EnableLogging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Transitions": {
        "NextAction": "DescribeIssue"
      }
    },
    {
      "Identifier": "DescribeIssue",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Please describe the issue you are experiencing. We'll record your description and open a support ticket."
      },
      "Transitions": {
        "NextAction": "Beep",
        "Errors": [
          {
            "NextAction": "Beep",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "Beep",
      "Type": "MessageParticipant",
      "Parameters": {
        "Media": {
          "Uri": "https://amazon-connect-866e38e51ca5.s3.amazonaws.com/prompts/beep.wav",
          "SourceType": "S3",
          "MediaType": "Audio"
        }
      },
      "Transitions": {
        "NextAction": "EnableRecording",
        "Errors": [
          {
            "NextAction": "EnableRecording",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "EnableRecording",
      "Type": "UpdateContactRecordingAndAnalyticsBehavior",
      "Parameters": {
        "VoiceBehavior": {
          "VoiceRecordingBehavior": {
            "RecordedParticipants": [],
            "IVRRecordingBehavior": "Enabled"
          }
        }
      },
      "Transitions": {
        "NextAction": "RecordingPause",
        "Errors": [
          {
            "NextAction": "RecordingPause",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "RecordingPause",
            "ErrorType": "ChannelMismatch"
          }
        ]
      }
    },
    {
      "Identifier": "RecordingPause",
      "Type": "MessageParticipant",
      "Parameters": {
        "SSML": "<speak><break time=\"10s\"/><break time=\"10s\"/></speak>"
      },
      "Transitions": {
        "NextAction": "DisableRecording",
        "Errors": [
          {
            "NextAction": "DisableRecording",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "DisableRecording",
      "Type": "UpdateContactRecordingAndAnalyticsBehavior",
      "Parameters": {
        "VoiceBehavior": {
          "VoiceRecordingBehavior": {
            "RecordedParticipants": [],
            "IVRRecordingBehavior": "Disabled"
          }
        }
      },
      "Transitions": {
        "NextAction": "PleaseWait",
        "Errors": [
          {
            "NextAction": "PleaseWait",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "PleaseWait",
            "ErrorType": "ChannelMismatch"
          }
        ]
      }
    },
    {
      "Identifier": "PleaseWait",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you. Please hold for a moment while we open a case for your issue."
      },
      "Transitions": {
        "NextAction": "CreateTicket",
        "Errors": [
          {
            "NextAction": "Disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "CreateTicket",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "InvocationTimeLimitSeconds": "8",
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:084396578198:function:asana-ticket-dev:live",
        "LambdaInvocationAttributes": {
          "CustomerId": "$.Attributes.CustomerId",
          "CallerAni": "$.CustomerEndpoint.Address"
        }
      },
      "Transitions": {
        "NextAction": "ReturnCaseNumber",
        "Errors": [
          {
            "NextAction": "Disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "ReturnCaseNumber",
      "Type": "MessageParticipant",
      "Parameters": {
        "SSML": "<speak>Your case number is <say-as interpret-as=\"characters\">$.External.caseNumber</say-as>. Our support team will review and respond to you as soon as possible. Thank you for calling.</speak>"
      },
      "Transitions": {
        "NextAction": "Disconnect",
        "Errors": [
          {
            "NextAction": "Disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "Disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {}
    }
  ],
  "Settings": {
    "InputParameters": [],
    "OutputParameters": [],
    "Transitions": [
      {
        "DisplayName": "Success",
        "ReferenceName": "Success",
        "Description": ""
      },
      {
        "DisplayName": "Error",
        "ReferenceName": "Error",
        "Description": ""
      }
    ]
  }
}